---
import Marketing from "../layouts/Marketing.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { Content } from "../generated/changelog.md";
import { MARKETPLACE_URL, RELEASES_URL, SITE_URL, breadcrumbs } from "../data/site.mjs";

const trail = breadcrumbs([["Leadlens", `${SITE_URL}/`], ["Changelog", `${SITE_URL}/changelog/`]]);
---

<Marketing
  title="Changelog · Leadlens"
  description="What's new in each Leadlens release: features, fixes and Emailens engine updates for the VS Code extension for Adobe Marketo Engage."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(trail)} />
  <div class="page">
    <SiteHeader tone="light" current="changelog" />
    <main class="page-main" id="main">
      <div class="container">
        <div class="page-intro">
          <h1>Changelog</h1>
          <p class="lede">What's new in Leadlens. Each new version reaches Marketplace and Open VSX installs as an automatic update, and its compatibility data updates with the Emailens engine.</p>
          <div class="pill-links">
            <a class="pill-link" href={MARKETPLACE_URL}>Visual Studio Marketplace</a>
            <a class="pill-link" href={RELEASES_URL}>Latest build on GitHub</a>
          </div>
        </div>
        <div class="prose">
          <Content />
        </div>
      </div>
    </main>
  </div>
  <SiteFooter />
</Marketing>
