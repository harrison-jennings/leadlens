---
// The Leadlens mark: a lens dot between token braces (docs/brand/README.md).
// With `blink`, the dot moves like an eye (src/scripts/blink.ts): "repeat" for
// the header, "once" for the footer.
interface Props {
  size?: number;
  tile?: string;
  blink?: "repeat" | "once";
}
const { size = 32, tile = "#1B2640", blink } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 128 128" aria-hidden="true" data-blink={blink}>
  <rect class="logo-tile" width="128" height="128" rx="28" fill={tile}></rect>
  <path d="M46 30 C37 30 35 36 35 44 L35 54 C35 60 31 64 25 64 C31 64 35 68 35 74 L35 84 C35 92 37 98 46 98" fill="none" stroke="#F4F7FB" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"></path>
  <path d="M82 30 C91 30 93 36 93 44 L93 54 C93 60 97 64 103 64 C97 64 93 68 93 74 L93 84 C93 92 91 98 82 98" fill="none" stroke="#F4F7FB" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"></path>
  <g class="logo-look"><circle class="logo-eye" cx="64" cy="64" r="13" fill="#3FD6C1"></circle></g>
</svg>

{blink && <script>import "../scripts/blink.ts";</script>}

<style is:global>
  /* The eye squashes and moves about its own centre. */
  .logo-eye {
    transform-box: fill-box;
    transform-origin: center;
  }
</style>
