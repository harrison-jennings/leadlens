---
import "../styles/fonts.css";
import "../styles/site.css";
import Analytics from "@vercel/analytics/astro";
import { SITE_URL, SOCIAL_IMAGE, TAGLINE } from "../data/site.mjs";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  /** False for a page with no address of its own, such as the 404 page. */
  canonical?: boolean;
}
const { title, description = TAGLINE, bodyClass, canonical: hasCanonical = true } = Astro.props;
const canonical = hasCanonical ? new URL(Astro.url.pathname, SITE_URL).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#121A2B" />
    <link rel="icon" href="/generated/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/generated/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/generated/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Leadlens" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={SOCIAL_IMAGE.url} />
    <meta property="og:image:width" content={String(SOCIAL_IMAGE.width)} />
    <meta property="og:image:height" content={String(SOCIAL_IMAGE.height)} />
    <meta property="og:image:alt" content={SOCIAL_IMAGE.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={SOCIAL_IMAGE.alt} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <Analytics />
  </body>
</html>
